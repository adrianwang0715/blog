---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";
import { getPostUrlBySlug } from "@/utils/url-utils";
import { getCollection } from "astro:content";

/**
 * 文件树组件 —— 把 src/content/posts/ 的目录结构渲染成可折叠的树。
 *
 * 树是「构建时」根据文章的 entry.id（= 相对 posts 的路径，去掉扩展名）生成的，
 * 所以它反映的是仓库里真实的文件夹层级。
 * 展开 / 折叠用原生 <details>，不需要 JS。
 */

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

// 可通过 sidebarConfig 的 customProps 覆盖
const custom = (widgetConfig?.customProps ?? {}) as {
	title?: string;
	showRoot?: boolean;
	collapseByDefault?: boolean;
};

// 默认「展开」，与折叠相反：collapseByDefault=true 时默认收起
const defaultOpen = custom.collapseByDefault !== true;
const showRoot = custom.showRoot !== false;

type TreeNode = {
	name: string; // 目录段名 / 文章标题
	url?: string; // 有值 = 这个节点本身是一篇文章
	indexTitle?: string; // 目录下的 index.md 的标题
	isPost: boolean;
	children: TreeNode[];
	total: number;
};

// ---------- 1. 取文章（过滤规则与主题 content-utils 保持一致）----------
const entries = await getCollection("posts", ({ data }) =>
	import.meta.env.PROD ? data.draft !== true : true,
);

// ---------- 2. 按 entry.id 的目录层级建树 ----------
const root: TreeNode = { name: "posts", isPost: false, children: [], total: 0 };

function findFolder(parent: TreeNode, name: string): TreeNode {
	let node = parent.children.find((c) => !c.isPost && c.name === name);
	if (!node) {
		node = { name, isPost: false, children: [], total: 0 };
		parent.children.push(node);
	}
	return node;
}

for (const entry of entries) {
	const segs = entry.id.split("/");
	const leaf = segs[segs.length - 1];
	// 目录下的 index.md 视为「目录主页」，并入文件夹本身
	const isIndex = leaf === "index" && segs.length > 1;
	const folderSegs = segs.slice(0, -1);

	let cur = root;
	for (const seg of folderSegs) cur = findFolder(cur, seg);

	const postUrl = getPostUrlBySlug(entry.id);

	if (isIndex) {
		cur.url = postUrl;
		cur.indexTitle = entry.data.title || leaf;
	} else {
		cur.children.push({
			name: entry.data.title || leaf,
			url: postUrl,
			isPost: true,
			children: [],
			total: 1,
		});
	}
}

// ---------- 3. 自底向上统计每个节点下的文章总数 ----------
function computeTotal(node: TreeNode): number {
	if (node.isPost) return 1;
	let total = node.url ? 1 : 0;
	for (const child of node.children) total += computeTotal(child);
	node.total = total;
	return total;
}
computeTotal(root);

// 目录在前、文章在后，各自按名称排序（用中文拼音友好的 localeCompare）
const collator = new Intl.Collator("zh-Hans-CN", { numeric: true });
function sortNode(node: TreeNode) {
	const folders = node.children.filter((c) => !c.isPost);
	const posts = node.children.filter((c) => c.isPost);
	folders.sort((a, b) => collator.compare(a.name, b.name));
	posts.sort((a, b) => collator.compare(a.name, b.name));
	node.children = [...folders, ...posts];
	for (const f of folders) sortNode(f);
}
sortNode(root);

// ---------- 4. 渲染 ----------
const FOLDER_ICON = `<svg class="pt-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M3 7a2.5 2.5 0 0 1 2.5-2.5h3.1c.62 0 1.2.23 1.66.64l1.03.92c.2.18.47.28.74.28h5.47A2.5 2.5 0 0 1 21 8.84v8.66A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5V7Z"/></svg>`;
const FILE_ICON = `<svg class="pt-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M14 3.5H7.5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8l-4.5-4.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.6" d="M14 3.5V8h4.5"/></svg>`;
const CHEVRON = `<svg class="pt-chev" viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m9 5.5 6 6.5-6 6.5"/></svg>`;

function esc(s: string): string {
	return s
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;");
}

function renderNode(node: TreeNode): string {
	// 叶子文章
	if (node.isPost) {
		return `<a class="pt-row pt-post" href="${node.url}" title="${esc(node.name)}">${FILE_ICON}<span class="pt-label">${esc(node.name)}</span></a>`;
	}

	const label = node.indexTitle ?? node.name;
	const head = node.url
		? `<a class="pt-name" href="${node.url}" title="${esc(label)}">${esc(label)}</a>`
		: `<span class="pt-name" title="${esc(label)}">${esc(label)}</span>`;

	const kids = node.children.map((c) => renderNode(c)).join("");

	// 空目录：不渲染折叠箭头
	if (!kids) {
		return `<div class="pt-row pt-folder pt-leaf-folder">${FOLDER_ICON}${head}<span class="pt-count">${node.total}</span></div>`;
	}

	return `<details class="pt-node"${defaultOpen ? " open" : ""}>
  <summary class="pt-row pt-folder">${CHEVRON}${FOLDER_ICON}${head}<span class="pt-count">${node.total}</span></summary>
  <div class="pt-kids">${kids}</div>
</details>`;
}

// showRoot=false 时直接把顶层内容铺开，不显示 posts 这一行
const treeHtml = showRoot
	? renderNode(root)
	: root.children.map((c) => renderNode(c)).join("");
---

<WidgetLayout
    id="post-tree"
    name={custom.title ?? "文件树"}
    showTitle={widgetConfig?.showTitle !== false}
    class={className}
    style={style}
>
    <div class="post-tree" data-show-root={String(showRoot)} set:html={treeHtml} />
</WidgetLayout>

<style is:global>
    .post-tree {
        font-size: 0.8125rem;
        line-height: 1.5;
    }

    .post-tree .pt-row {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.25rem;
        border-radius: 0.375rem;
        min-width: 0;
    }

    .post-tree a.pt-row:hover,
    .post-tree .pt-node > summary:hover {
        background: rgba(127, 127, 127, 0.09);
    }

    /* 展开/折叠箭头 */
    .post-tree .pt-chev {
        flex: none;
        opacity: 0.5;
        transition: transform 0.18s ease;
    }

    .post-tree .pt-node[open] > summary .pt-chev {
        transform: rotate(90deg);
    }

    .post-tree summary {
        cursor: pointer;
        list-style: none;
    }

    .post-tree summary::-webkit-details-marker {
        display: none;
    }

    .post-tree .pt-icon {
        flex: none;
        opacity: 0.85;
    }

    .post-tree .pt-folder .pt-icon {
        color: var(--primary, #0f6e56);
    }

    .post-tree .pt-post .pt-icon {
        opacity: 0.45;
    }

    /* 文字：单行截断 */
    .post-tree .pt-name,
    .post-tree .pt-label {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: inherit;
        text-decoration: none;
    }

    .post-tree a.pt-name:hover {
        color: var(--primary, #0f6e56);
    }

    .post-tree .pt-count {
        flex: none;
        font-size: 0.7rem;
        opacity: 0.45;
        font-variant-numeric: tabular-nums;
    }

    /* 缩进引导线 */
    .post-tree .pt-kids {
        margin-left: 0.5rem;
        padding-left: 0.5rem;
        border-left: 1px solid rgba(127, 127, 127, 0.22);
    }

    /* 顶层 posts 那一行稍微强调一点 */
    .post-tree > .pt-node > summary > .pt-name {
        font-weight: 500;
    }
</style>
